Option Explicit
' Generated by ORYND External CAD Extension prototype.
' Review this code before running it in SolidWorks.
' Units in operation plan: millimeters. SolidWorks API calls use meters.

Dim swApp As Object
Dim swModel As Object

Sub main()
    Set swApp = Application.SldWorks
    Set swModel = swApp.NewPart
    If swModel Is Nothing Then
        MsgBox "Could not create SolidWorks part document."
        Exit Sub
    End If
    swModel.Extension.CustomPropertyManager("").Add3 "ORYNDPlan", 30, "brake_disc", 2

    ' disc_sketch: Sketch rotor outer circle
    ORYND_CreateSketch swModel, "Top"
    ' outer_disc: Outer diameter 280 mm
    ORYND_Circle swModel, 0.000000000, 0.000000000, 0.140000000
    ' disc_body: Extrude rotor thickness
    ORYND_Extrude swModel, 0.028000000, False
    ' center_bore: Center bore
    ORYND_Hole swModel, 0.000000000, 0.000000000, 0.061000000, True, 0.000000000
    ' vent_inner: Simplified annular vent relief
    ORYND_Hole swModel, 0.000000000, 0.000000000, 0.182000000, True, 0.000000000
    ' bolt_1: Through hole 1 on 115 mm bolt circle
    ORYND_Hole swModel, 0.057500000, 0.000000000, 0.012000000, True, 0.000000000
    ' bolt_2: Through hole 2 on 115 mm bolt circle
    ORYND_Hole swModel, 0.017768000, 0.054686000, 0.012000000, True, 0.000000000
    ' bolt_3: Through hole 3 on 115 mm bolt circle
    ORYND_Hole swModel, -0.046518000, 0.033798000, 0.012000000, True, 0.000000000
    ' bolt_4: Through hole 4 on 115 mm bolt circle
    ORYND_Hole swModel, -0.046518000, -0.033798000, 0.012000000, True, 0.000000000
    ' bolt_5: Through hole 5 on 115 mm bolt circle
    ORYND_Hole swModel, 0.017768000, -0.054686000, 0.012000000, True, 0.000000000
    ' bolt_pattern: Bolt-hole pattern declaration
    ORYND_Pattern swModel, "circular", 5, 0.057500000, "Z", "bolt_1"
    ' edge_softening: Soften rotor edges
    ORYND_Fillet swModel, 0.001500000, "outer_edges"
    ' export_step: Export editable STEP
    ORYND_Export swModel, "STEP", "brake_disc.step"
End Sub

Private Sub ORYND_CreateSketch(ByVal model As Object, ByVal planeName As String)
    Dim ok As Boolean
    ok = False
    If planeName = "Front" Then ok = model.Extension.SelectByID2("Front Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0)
    If planeName = "Top" Then ok = model.Extension.SelectByID2("Top Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0)
    If planeName = "Right" Then ok = model.Extension.SelectByID2("Right Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0)
    If ok Then model.SketchManager.InsertSketch True
End Sub

Private Sub ORYND_Circle(ByVal model As Object, ByVal x As Double, ByVal y As Double, ByVal radius As Double)
    model.SketchManager.CreateCircleByRadius x, y, 0#, radius
End Sub

Private Sub ORYND_Rectangle(ByVal model As Object, ByVal x As Double, ByVal y As Double, ByVal width As Double, ByVal height As Double)
    Dim x1 As Double, y1 As Double, x2 As Double, y2 As Double
    x1 = x - width / 2#: y1 = y - height / 2#
    x2 = x + width / 2#: y2 = y + height / 2#
    model.SketchManager.CreateCenterRectangle x, y, 0#, x2, y2, 0#
End Sub

Private Sub ORYND_Extrude(ByVal model As Object, ByVal depth As Double, ByVal symmetric As Boolean)
    model.FeatureManager.FeatureExtrusion2 True, False, False, 0, 0, depth, depth, False, False, False, False, 0#, 0#, False, False, False, False, True, True, True, 0, 0, False
End Sub

Private Sub ORYND_Revolve(ByVal model As Object, ByVal axisName As String, ByVal angleDeg As Double)
    ' Placeholder wrapper for future SolidWorks revolve implementation.
    ' Kept explicit so the static validator can constrain model output.
End Sub

Private Sub ORYND_Cut(ByVal model As Object, ByVal depth As Double, ByVal throughAll As Boolean)
    If throughAll Then
        model.FeatureManager.FeatureCut4 True, False, False, 1, 1, depth, depth, False, False, False, False, 0#, 0#, False, False, False, False, False, True, True, True, True, False, 0, 0, False, False
    Else
        model.FeatureManager.FeatureCut4 True, False, False, 0, 0, depth, depth, False, False, False, False, 0#, 0#, False, False, False, False, False, True, True, True, True, False, 0, 0, False, False
    End If
End Sub

Private Sub ORYND_Hole(ByVal model As Object, ByVal x As Double, ByVal y As Double, ByVal diameter As Double, ByVal throughAll As Boolean, ByVal depth As Double)
    model.Extension.SelectByID2 "", "FACE", 0, 0, 0, False, 0, Nothing, 0
    model.SketchManager.InsertSketch True
    model.SketchManager.CreateCircleByRadius x, y, 0#, diameter / 2#
    If throughAll Then
        ORYND_Cut model, 0#, True
    Else
        ORYND_Cut model, depth, False
    End If
End Sub

Private Sub ORYND_Pattern(ByVal model As Object, ByVal patternType As String, ByVal count As Integer, ByVal radius As Double, ByVal axisName As String, ByVal targetRef As String)
    ' Pattern is declared in the plan. Future add-in runner will map references to selected features.
End Sub

Private Sub ORYND_Fillet(ByVal model As Object, ByVal radius As Double, ByVal selectionName As String)
    On Error Resume Next
    model.FeatureManager.FeatureFillet3 195, radius, 0#, 0, 0, 0, 0, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing
    On Error GoTo 0
End Sub

Private Sub ORYND_Chamfer(ByVal model As Object, ByVal distance As Double, ByVal selectionName As String)
    On Error Resume Next
    model.FeatureManager.InsertFeatureChamfer 4, 1, distance, 0#, 0#, 0#, 0#, 0
    On Error GoTo 0
End Sub

Private Sub ORYND_Mate(ByVal model As Object, ByVal mateType As String, ByVal entityA As String, ByVal entityB As String, ByVal distance As Double)
    ' Assembly mate declaration for later add-in execution.
End Sub

Private Sub ORYND_Export(ByVal model As Object, ByVal formatName As String, ByVal fileName As String)
    ' SaveAs3 writes only the explicit user-visible export filename generated in the preview.
    model.SaveAs3 fileName, 0, 2
End Sub