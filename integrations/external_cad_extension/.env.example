# Copy to .env locally. Do not commit real values.

# Supabase client/local companion values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Existing ORYND desktop auth also accepts:
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Backend-only. Existing ORYND backend uses SUPABASE_SERVICE_ROLE_KEY.
# Do not expose in UI, browser, chat, logs, or client bundles.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Optional model providers.
ANTHROPIC_API_KEY=sk-ant_REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME

# Optional local model endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
